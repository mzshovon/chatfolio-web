# Port the app listens on inside the container, and the host port it's
# published to (docker-compose maps them 1:1). Override per environment,
# e.g. PORT=8080 docker compose up.
PORT=3000

# Destinations the landing page's sign-in / sign-up / purchase buttons
# redirect to. Must be NEXT_PUBLIC_-prefixed to be readable in the browser.
# Point these at the auth app's URLs for each environment (dev/test/prod).
NEXT_PUBLIC_SIGN_IN_URL=http://localhost:3000/signin
NEXT_PUBLIC_SIGN_UP_URL=http://localhost:3000/signup
NEXT_PUBLIC_PURCHASE_URL=http://localhost:3000/signup

# Google Analytics 4 Measurement ID (from the GA4 property's Data Streams
# page). Leave unset to disable analytics entirely, e.g. in local dev.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
